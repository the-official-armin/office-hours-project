# Copy to backend/.env and fill in. Never commit .env.
# uvicorn reads it with --env-file .env; docker compose reads it automatically.

# Database. Leave DATABASE_URL unset for the zero-setup SQLite file (office_hours.db).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=office_hours_db
# DATABASE_URL=postgresql://postgres:change-me@localhost:5432/office_hours_db

# Sign-in tokens. Deployed: a long random value, e.g. python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-this-development-secret
JWT_EXPIRE_MINUTES=60

# The school's time zone. Hosts run in UTC, so set this when deployed.
SCHOOL_TZ=America/Los_Angeles

# Deployed frontend URL(s), comma-separated. Empty allows any localhost port (development).
CORS_ORIGINS=

# Demo data on an empty database. false when deployed.
AUTO_SEED=true
