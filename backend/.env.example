# Copy to backend/.env and fill in. Never commit .env.
# The backend (server, alembic, scripts) and docker compose read it automatically; real environment variables win.

# Database. Leave DATABASE_URL unset for the zero-setup SQLite file (office_hours.db).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=office_hours_db
# DATABASE_URL=postgresql://postgres:change-me@localhost:5432/office_hours_db

# Sign-in tokens. Deployed: a long random value, e.g. python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-this-development-secret
JWT_EXPIRE_MINUTES=60

# The school's time zone. Hosts run in UTC, so set this when deployed.
SCHOOL_TZ=America/Los_Angeles

# Deployed frontend URL(s), comma-separated. Empty allows any localhost port (development).
CORS_ORIGINS=

# Demo data on an empty database. false when deployed.
AUTO_SEED=true

# Email through Postmark. Empty POSTMARK_TOKEN = emails go to the log, not sent. Test: venv/bin/python -m app.mailer you@waprep.org
POSTMARK_TOKEN=
# Sender: a confirmed Sender Signature in Postmark (later an address on a DKIM-verified domain).
EMAIL_FROM=
# The frontend's address, for links in emails.
APP_URL=http://localhost:5173

# Reminder emails (app/reminders.py). Deployed: a timer calls GET /jobs/reminders with "Authorization: Bearer <CRON_SECRET>"
# every 5 minutes; empty CRON_SECRET turns that endpoint off. Locally: run them inside the backend every N minutes (0 = off).
CRON_SECRET=
REMINDER_INTERVAL_MINUTES=0

# Sessions: the app refreshes a sign-in for up to this many days, then people sign in again.
SESSION_MAX_DAYS=7
# Rate limits count attempts per visitor IP. Behind a proxy name the header with the visitor's address: x-real-ip on Vercel.
CLIENT_IP_HEADER=
